{
  "name": "@open-media-disc/studio",
  "version": "0.2.0",
  "private": true,
  "description": "OMD Studio: a desktop app for packaging, labeling, burning, and playing Open Media Discs.",
  "license": "MIT",
  "main": "./dist/main/main.cjs",
  "bin": {
    "omd-studio-shots": "./bin/omd-studio-shots.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node build.mjs",
    "start": "electron .",
    "watch": "node build.mjs --watch",
    "dev": "node build.mjs && electron .",
    "dev:fixtures": "node build.mjs && electron . --omd-data=fixtures",
    "screenshots": "node build.mjs && electron . --omd-data=fixtures --omd-screenshots=all --omd-out=./screenshots",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@open-media-disc/core": "workspace:*",
    "@open-media-disc/label": "workspace:*",
    "@open-media-disc/ui": "workspace:*",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "electron": "^31.3.0",
    "esbuild": "^0.23.1",
    "rimraf": "^5.0.9",
    "typescript": "^5.5.3"
  }
}
