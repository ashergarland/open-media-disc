{
  "name": "open-media-disc",
  "version": "0.2.0",
  "private": true,
  "description": "Open Media Disc (OMD): an open-source physical music format. Monorepo for the OMD SDK, CLI, and label tools.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "onboard": "pnpm install && pnpm build && pnpm test && pnpm lint",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\"",
    "gen:examples": "tsx scripts/make-examples.mts",
    "omd": "node packages/cli/dist/bin/omd.js",
    "studio": "pnpm --filter @open-media-disc/studio start"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.3"
  }
}
